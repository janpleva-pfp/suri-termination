{
  "name": "contract-cancellation-app",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev-old": "ts-node server.ts",
    "dev": "next dev -p 3003",
    "dev:css-reload": "powershell -ExecutionPolicy Bypass -File ./dev-css-reload.ps1",
    "prebuild": "eslint . --ext .js,.jsx,.ts,.tsx --fix && tsc && next lint",
    "build": "next build && tsc --project tsconfig.server.json",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "remove-console": "node scripts/remove-console-logs.js",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "test": "jest",
    "type-check": "npx --yes -p typescript@5.3 tsc --noEmit -p tsconfig.type-check.json",
    "test:api": "jest --verbose --testRegex \".*apitest\\.ts$\""
  },
  "dependencies": {
    "@google-cloud/logging-winston": "^6.0.0",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@pfp/frontend-platform": "0.0.65",
    "@popperjs/core": "^2.10.2",
    "@stomp/stompjs": "^6.1.2",
    "@types/jsonwebtoken": "^9.0.10",
    "axios": "^1.7.9",
    "bootstrap": "^5.3.0",
    "classnames": "^2.5.1",
    "cleave.js": "^1.6.0",
    "cookie": "0.7.0",
    "date-fns": "^4.1.0",
    "formik": "^2.2.9",
    "fuse.js": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "next": "^14.2.24",
    "next-i18next": "^10.0.1",
    "posthog-js": "^1.87.6",
    "prop-types": "^15.6.0",
    "ramda": "^0.31.0",
    "rc-input-number": "^9.3.0",
    "react": "^18.3.1",
    "react-bootstrap": "^2.10.9",
    "react-calendar": "^5.1.0",
    "react-dom": "^18.3.1",
    "react-ga": "^3.3.0",
    "react-ga4": "^2.1.0",
    "react-gtm-module": "^2.0.11",
    "react-hook-form": "^7.62.0",
    "react-loading-skeleton": "^3.0.1",
    "react-range": "^1.10.0",
    "react-select": "^5.10.0",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.0",
    "uuid": "^8.3.2",
    "winston": "3.2.1",
    "yup": "^1.4.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^12.3.1",
    "@testing-library/jest-dom": "^5.16.2",
    "@testing-library/react": "^12.1.2",
    "@types/cleave.js": "^1.4.12",
    "@types/cookie": "^0.4.1",
    "@types/enzyme": "^3.10.12",
    "@types/jest": "^29.5.14",
    "@types/node": "^18.0.0",
    "@types/pretty": "^2.0.1",
    "@types/ramda": "^0.31.0",
    "@types/react": "^18.0.1",
    "@types/react-calendar": "^3.4.3",
    "@types/react-gtm-module": "^2.0.1",
    "@types/react-test-renderer": "^18.0.0",
    "@types/uuid": "^8.3.4",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "autoprefixer": "^10.3.7",
    "eslint": "7.23.0",
    "eslint-config-next": "^14.2.24",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-jest": "^26.7.0",
    "eslint-plugin-unused-imports": "^3.0.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-fetch-mock": "^3.0.3",
    "postcss": "8.4.31",
    "prettier": "^2.7.1",
    "pretty": "^2.0.0",
    "sass": "^1.43.4",
    "ts-jest": "^29.2.5"
  },
  "prettier": {
    "arrowParens": "always",
    "bracketSpacing": true,
    "singleQuote": true,
    "semi": true,
    "trailingComma": "all",
    "printWidth": 120
  },
  "resolutions": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "**/**/react": "^18.3.1",
    "**/**/react-dom": "^18.3.1",
    "@pfp/frontend-platform/react": "^18.3.1",
    "@pfp/frontend-platform/react-dom": "^18.3.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
